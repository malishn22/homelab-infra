# Container name
JF_CONTAINER_NAME=jellyfin
# Host port for direct access (nginx proxies by service name, not port)
JF_HOST_PORT=8096
# Config + cache — keep on /home, NOT /var (12G volume)
JF_CONFIG_DIR=./config
JF_CACHE_DIR=./cache
# Media library root, mounted read-only at /media
JF_MEDIA_DIR=/srv/media
# URL Jellyfin advertises to clients — must match the nginx vhost
JF_PUBLISHED_URL=https://media.example.lan
