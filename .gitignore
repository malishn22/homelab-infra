**/.env
# Linkding
linkding/data/
linkding/.env

# Prometheus & Node Exporter
monitoring/prometheus/*
!monitoring/prometheus/
!monitoring/prometheus/prometheus.yml
# Alerting rules are source, not data — without these negations the blanket
# ignore above would silently leave a fresh clone with no alerts at all.
!monitoring/prometheus/rules/
!monitoring/prometheus/rules/*.yml
monitoring/node_exporter/

# Alertmanager — the Discord webhook URL is a live credential.
# alertmanager.yml points at it via webhook_url_file, so the config itself is safe to commit.
monitoring/alertmanager/discord_url

# Nginx
nginx/certs/
# Rendered from templates/*.template at container start — hold the real public hostnames.
nginx/conf.d/calimali-api.conf
nginx/conf.d/jellyfin.conf

# Jellyfin
jellyfin/config/
jellyfin/cache/
# Cron prune-run record (host-specific paths/disk figures) — keep local, don't publish
scripts/docker-cleanup.log

# Graphify generated output
graphify-out/
