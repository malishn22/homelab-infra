# Rendered to conf.d/calimali-api.conf at container start (nginx image envsubst). The
# public hostname comes from CALIMALI_PUBLIC_HOST in .env; the rendered conf.d file is
# gitignored, so the real value is never committed. HTTP-only by design: TLS is terminated
# upstream at the public edge, and access is gated by the app's own JWT — not the network.
server {
    listen 80;
    server_name ${CALIMALI_PUBLIC_HOST};

    location / {
        proxy_pass http://calimali-api:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
