# Name of the nginx container
NGINX_CONTAINER_NAME=nginx-reverse-proxy

# Host port that will expose nginx (host:container → 80:80 by default)
NGINX_HOST_PORT=80

# Minecraft app upstreams (optional overrides; defaults are used if unset)
MINECRAFT_API_PORT=8000
MINECRAFT_WEB_INTERNAL_PORT=80
MINECRAFT_WEB_SERVER_NAME=minecraft.home

# Jellyfin upstream (optional overrides; defaults are used if unset)
JELLYFIN_INTERNAL_PORT=8096
JELLYFIN_SERVER_NAME=media.example.lan

# calimali public vhost — rendered into conf.d/ from templates/calimali-api.conf.template.
# Set to the public domain the API is served at; the real value stays in .env (gitignored).
CALIMALI_PUBLIC_HOST=api.example.com
