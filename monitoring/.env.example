# Monitoring stack environment variables.
# Copy to `.env` (gitignored) and fill in before `docker compose up`.

# Grafana initial admin credentials.
# Without these, Grafana defaults to admin/admin — do not leave that on a
# host-published port. GF_SECURITY_ADMIN_PASSWORD is required (compose will
# refuse to start if it is unset).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
