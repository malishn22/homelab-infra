    {
      "datasource": {
        "type": "loki",
        "uid": "loki-homelab"
      },
      "description": "Requests actually served in the selected time range, counted from the access log.\n\nDeliberately NOT from nginx_http_requests_total: that counter includes the exporter's own stub_status polls, which run about 4/min forever and would show ~0.07 req/s of traffic on a completely idle proxy. The stub_status location sets access_log off, so those polls never reach the log \u2014 which makes the log the honest source.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": {
