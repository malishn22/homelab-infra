    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "Is Prometheus successfully scraping nginx-exporter?\n\nThis is a different failure from the tile beside it: this one goes DOWN if the exporter container dies or the network to it breaks. NO DATA means Grafana cannot reach Prometheus at all.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "OK"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
