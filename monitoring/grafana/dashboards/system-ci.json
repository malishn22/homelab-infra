    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-homelab"
      },
      "description": "The root cgroup is everything on the box rolled up \u2014 containers, systemd, the CI runners, your login sessions. cAdvisor does not know about containers at the kernel level \u2014 it walks the cgroup v2 tree and emits one series per node, with `id` being the cgroup path. It sets a `name` label only for cgroups it recognises as Docker containers, which is why every query on the Containers dashboard filters name!=\"\". This dashboard is the other 44 of 64 series: the root cgroup and the systemd slices.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{id=\"/\"}[5m])) / max(machine_cpu_cores)",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
